# mock: 브라우저 localStorage 데모 데이터(백엔드 불필요) / live: 실제 API 호출
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# live 모드에서 백엔드에 CORS 설정이 없을 때: Next가 /api/v1/* 을 이 주소로 넘긴다(서버 전용 변수).
# 이때 NEXT_PUBLIC_API_BASE_URL 은 /api/v1 로 둔다.
#   API_PROXY_TARGET=http://localhost:8080
#   NEXT_PUBLIC_API_BASE_URL=/api/v1
